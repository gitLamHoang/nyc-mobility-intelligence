{
  "name": "nyc-mobility-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/*.test.ts",
    "format:check": "prettier --check src index.html package.json tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
